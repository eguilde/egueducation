{
  "name": "egueducation-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "quality:ui": "node scripts/audit-ui.mjs",
    "api:generate": "openapi-typescript ../openapi/openapi.json -o src/api/generated.ts"
  },
  "dependencies": {
    "@primeuix/themes": "^3.0.0",
    "@primeicons/react": "^8.0.0",
    "@primereact/core": "^11.1.0",
    "@primereact/ui": "^11.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oauth4webapi": "^3.8.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
